#!/bin/bash
# Shared configuration for the scripts in this folder.
#
# Usage:
#   cp scripts/00-config.env.example scripts/config.env
#   nano scripts/config.env              # edit the values for your setup
#   source scripts/config.env            # before running any other script
#
# scripts/config.env is gitignored on purpose: it is specific to your
# hardware and household, don't commit it.

# Linux user created during the Debian install (owns the containers' files)
export SERVER_USER="stefano"

# Timezone used by the OS and every container
export TZ="Europe/Madrid"

# Labels given to the two USB SSDs when they are partitioned
# (03-prepare-disks.sh). Change only if you already used different labels.
export MEDIA_LABEL="media"
export BACKUP_LABEL="backup"

# Mount points for the two SSDs
export MEDIA_DIR="/srv/media"
export BACKUP_DIR="/srv/backup"

# Where the docker-compose stacks live, on the internal NVMe
export STACK_DIR="/opt/stack"
export IMMICH_DIR="/opt/immich"

# uid:gid every container runs as. Must match `id -u`/`id -g` for
# $SERVER_USER (Debian gives the first user uid/gid 1000 by default).
export PUID=1000
export PGID=1000
