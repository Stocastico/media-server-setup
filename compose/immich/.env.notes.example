# Immich ships a large example.env with many advanced options; you only need
# to change these lines in the downloaded .env. Leave everything else at
# its default.

UPLOAD_LOCATION=/srv/media/immich-library   # phone uploads land here (USB SSD)
DB_DATA_LOCATION=/opt/immich/postgres       # database: internal NVMe, never on USB
TZ=Europe/Madrid
IMMICH_VERSION=v3                           # pin the major version; upgrade deliberately

# Generate with: openssl rand -hex 16
DB_PASSWORD=<paste a random string here>
