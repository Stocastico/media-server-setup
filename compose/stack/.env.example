# Copy to /opt/stack/.env on the server (scripts/09-generate-stack-env.sh
# does this for you automatically, including the correct RENDER_GID).
#
#   cp compose/stack/.env.example /opt/stack/.env
#   nano /opt/stack/.env

TZ=Europe/Madrid
PUID=1000
PGID=1000

# GID of the host's "render" group, needed so containers can use the Intel
# iGPU. Find it with: getent group render | cut -d: -f3
RENDER_GID=105

# Root of the media library on the host.
MEDIA_DIR=/srv/media
